# Server Configuration
PORT=8000
HOST=127.0.0.1
DEFAULT_MODEL=chat

# Inference Defaults
DEFAULT_MAX_NEW_TOKENS=200
DEFAULT_TEMPERATURE=0.8
DEFAULT_TOP_K=40
DEFAULT_REPETITION_PENALTY=1.1
DEFAULT_DEVICE=auto

# Security & Concurrency
MAX_CONCURRENT_GENERATIONS=4
RATE_LIMIT_PER_MINUTE=120
# Optional: Set MINI_GPT_API_KEY to enforce Bearer token authentication
MINI_GPT_API_KEY=

